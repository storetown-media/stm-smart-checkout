msgstr "Bereits Kunde? %s"

msgid "Billing details"
msgstr "Rechnungsdetails"

msgid "Border color"
msgstr "Rahmenfarbe"

msgid "Both pages usually have no H1 once the theme header is hidden."
msgstr "Ohne Theme-Kopf haben beide Seiten sonst meist keine H1."

msgid "Card background"
msgstr "Kartenhintergrund"

msgid "Card corner radius (px)"
msgstr "Karten-Eckenradius (px)"

